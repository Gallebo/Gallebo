# Gallebo — Vercel (Next.js) environment variables
# Copy values into Vercel → Project → Settings → Environment Variables.
# Never commit real secrets. See .env.example for the full local dev template.

# --- Public (bundled into the browser) ---

# Supabase project URL — used by lib/supabase/client.ts, middleware, and Server Components.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key — browser + cookie-based auth via @supabase/ssr (RLS applies).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical app URL — auth redirects, Didit session callback, Stripe Connect return URLs (lib/didit/client, lib/stripe/connect).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MapTiler tiles key — MapLibre maps in components/map/* (browser-only).
NEXT_PUBLIC_MAPTILER_API_KEY=

# VAPID public key — Web Push subscription in PushPermissionButton.tsx (browser).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Stripe publishable key — for client-side Stripe.js / Elements when wired (present in local env; not yet imported in code).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# PostHog — product analytics funnels (browser). Enable Vercel Analytics + Speed Insights in Vercel dashboard.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Server-only (Next.js API routes, Server Actions, lib/*) ---

# Service role — bypasses RLS in lib/supabase/admin.ts (webhooks, rate limit, Didit guards, Stripe handlers).
# Same value as Supabase project service role; also auto-injected into Edge Functions at runtime.
SUPABASE_SERVICE_ROLE_KEY=

# Didit API key — POST /api/didit/session via lib/didit/client.ts (x-api-key to verification.didit.me).
DIDIT_API_KEY=

# Didit workflow ID — session creation in lib/didit/client.ts.
DIDIT_WORKFLOW_ID=

# Didit webhook signing secret — isDiditConfigured() in lib/didit/config.ts and /api/didit/health.
# Primary consumer is Supabase Edge Function didit-webhook; keep the same value in Supabase Secrets.
DIDIT_WEBHOOK_SECRET=

# Phone/weight encryption at rest — lib/crypto/encryption-key.ts (required in production on Vercel).
PHONE_ENCRYPTION_KEY=

# Stripe secret — Checkout, Connect onboarding, webhooks in lib/stripe/* and /api/stripe/*, /api/pilot/setup-payouts.
# Same value needed in Supabase Secrets for process-payouts Edge Function.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret — only needed on Supabase Edge (stripe-webhook); optional on Vercel for env parity.
STRIPE_WEBHOOK_SECRET=
