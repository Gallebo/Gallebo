# Gallebo — Supabase Edge Functions secrets
# Set via: npx supabase secrets set KEY=value --project-ref <ref>
# Or: Supabase Dashboard → Project → Edge Functions → Secrets
# For local serve: npx supabase functions serve --env-file .env.local
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected on hosted Edge Functions.
# Include SUPABASE_SERVICE_ROLE_KEY below only for local `functions serve` (copy from Vercel env).

# --- Auth for pg_cron → Edge Function calls ---

# Bearer token checked by all cron-triggered functions (pilot-expiry, booking-expiry, process-payouts,
# process-notifications, process-reviews, send-flight-reminders, process-alert-expiry).
CRON_SECRET=

# --- Webhooks (external → Edge) ---

# Didit V3 HMAC secret (secret_shared_key from POST /v3/webhook/destinations/) — didit-webhook/index.ts.
# Same value as DIDIT_WEBHOOK_SECRET on Vercel (used there only for isDiditConfigured()).
DIDIT_WEBHOOK_SECRET=

# --- Transactional email & push (process-notifications) ---

# Resend API key — _shared/resend.ts sends queued emails from notification_queue.
# Production: verify gallebo.app domain in Resend Dashboard before go-live.
RESEND_API_KEY=

# Admin inbox for pilot_upgrade_submitted notifications (process-notifications).
ADMIN_EMAIL=admin@test.ai

# Web Push (server-side) — _shared/push.ts sends push notifications; pair with NEXT_PUBLIC_VAPID_PUBLIC_KEY on Vercel.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@gallebo.app

# --- Payments (process-payouts) ---

# Stripe secret — _shared/connect.ts creates Connect accounts and pilot transfers after completed flights.
# Same value as STRIPE_SECRET_KEY on Vercel.
STRIPE_SECRET_KEY=

# Stripe platform webhook signing secret — stripe-webhook/index.ts (Your account scope).
# Events: checkout.session.completed, charge.refunded. whsec_... from Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=

# Stripe Connect webhook signing secret — stripe-webhook/index.ts (Connected accounts scope).
# Events: account.updated. Separate destination in Stripe; its own whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=

# --- Local development only (auto-injected in production) ---

# Supabase project URL — _shared/supabase.ts admin client (auto-set on hosted Edge; needed for local serve).
# Usually same as NEXT_PUBLIC_SUPABASE_URL on Vercel.
SUPABASE_URL=

# Service role — _shared/supabase.ts (auto-set on hosted Edge; copy from Vercel for local serve).
SUPABASE_SERVICE_ROLE_KEY=
