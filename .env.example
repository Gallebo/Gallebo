# Gallebo — Flight Sharing Platform
# Copy to .env.local and fill in values. Never commit .env.local.

# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App URL (auth redirects, Didit callback)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MapTiler — public key for MapLibre tiles in the browser
NEXT_PUBLIC_MAPTILER_API_KEY=

# Didit KYC — server-side only (https://didit.me)
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_WORKFLOW_ID=

# Cron — protect /api/cron/* routes
CRON_SECRET=

# Phone encryption at rest (min 32 chars; server-only)
PHONE_ENCRYPTION_KEY=

# Stripe — server-only (Checkout + webhooks + Connect payouts)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend — optional; emails queue via process-notifications edge function
RESEND_API_KEY=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@gallebo.app
